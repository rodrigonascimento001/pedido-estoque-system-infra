# Datadog é opcional; não habilite o perfil observability sem preencher a chave.
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=local
DD_HOSTNAME=pedido-estoque-local

# Credenciais locais de desenvolvimento PostgreSQL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# LocalStack (perfil localstack): Secrets Manager e SSM para desenvolvimento local.
# Use somente valores fictícios; nunca configure credenciais reais aqui.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Keycloak local de desenvolvimento. Troque a senha antes de iniciar.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-only-change-me
KEYCLOAK_PORT=8180
KEYCLOAK_HOSTNAME=http://localhost:8180
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
# Client confidencial para criar usuários no realm pedido-estoque (defina um secret local).
KEYCLOAK_USER_REGISTRATION_CLIENT_SECRET=
# Usuário com a role operator para desenvolvimento local (gerencia estoque e lê qualquer pedido).
# Só é criado quando a senha está preenchida. Não reutilize essa senha fora do ambiente local.
KEYCLOAK_LOCAL_OPERATOR_USERNAME=local.operator
KEYCLOAK_LOCAL_OPERATOR_PASSWORD=
