# Datadog é opcional; não habilite o perfil observability sem preencher a chave.
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=local
DD_HOSTNAME=pedido-estoque-local

# Credenciais locais de desenvolvimento PostgreSQL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# LocalStack (perfil localstack): Secrets Manager e SSM para desenvolvimento local.
# Use somente valores fictícios; nunca configure credenciais reais aqui.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test